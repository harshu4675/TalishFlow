
# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/talishflow

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (generate strong secrets: openssl rand -base64 64) ─
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Encryption ────────────────────────────────────────────
ENCRYPTION_KEY=your_encryption_key_minimum_32_chars

# ── CSRF ──────────────────────────────────────────────────
CSRF_SECRET=your_csrf_secret_minimum_32_chars

# ── Session ───────────────────────────────────────────────
SESSION_SECRET=your_session_secret_minimum_32_chars

# ── Google OAuth ──────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3, Google+ API
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── YouTube Data API (optional) ───────────────────────────
# Leave BLANK if you don't have a key: imports still work via the
# keyless YouTube oEmbed metadata service (no title/duration, but
# uploads are never blocked by a missing or invalid key).
# If you set a value, it must be a real API key from
# https://console.cloud.google.com/apis/credentials — placeholder
# values are ignored by the server.
YOUTUBE_API_KEY=

# ── Meta / Instagram ──────────────────────────────────────
# Create at: https://developers.facebook.com/apps/
# Enable: Instagram Graph API, Instagram Basic Display API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_CALLBACK_URL=http://localhost:5000/api/v1/auth/instagram/callback

# ── OpenAI (for Whisper API — optional) ───────────────────
# If not set, the system uses local Whisper binary
OPENAI_API_KEY=your_openai_api_key_optional

# ── Email (for password reset) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TalishFlow <noreply@talishflow.com>"

# ── Storage ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5368709120

# ── Processing ───────────────────────────────────────────
# Leave blank to use system PATH (or the bundled ffmpeg-static/ffprobe-static)
FFMPEG_PATH=
FFPROBE_PATH=
# YouTube imports require yt-dlp on the server (pip install yt-dlp).
# Leave blank to use "yt-dlp" from PATH, or set the absolute path here.
YT_DLP_PATH=
WHISPER_MODEL=base
PYTHON_PATH=python3
# Python packages required for local transcription / detection:
#   pip install openai-whisper opencv-python-headless numpy

# ── Cleanup ───────────────────────────────────────────────
ASSET_TTL_HOURS=24