# ────────────────────────────────────────────────────────────
# TalishFlow — server environment
# Copy to server/.env and fill in real values. NEVER commit .env.
# ────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000
# Frontend base URL used for OAuth redirects back into the app
CLIENT_URL=http://localhost:3000

# Publicly reachable base URL of THIS API (no trailing slash).
# Required for Instagram publishing: Meta fetches media over HTTPS.
# In development leave as-is; in production set e.g. https://api.example.com
PUBLIC_API_URL=http://localhost:5000

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/talishflow

# ── Redis (job queues — optional in local dev; the app falls
#    back to an in-process queue when unreachable) ─────────
REDIS_URL=redis://localhost:6379

# ── JWT (generate strong secrets: openssl rand -base64 64) ─
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Encryption (AES for stored platform tokens + HMAC signing) ─
ENCRYPTION_KEY=your_encryption_key_minimum_32_chars

# ── Google OAuth (login + YouTube connect) ────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3.
# Authorized redirect URI must EXACTLY match GOOGLE_CALLBACK_URL.
# One callback handles both login and YouTube-connect flows.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── YouTube Data API (optional; enriches URL import metadata) ─
YOUTUBE_API_KEY=

# ── Meta / Instagram ──────────────────────────────────────
# Create at: https://developers.facebook.com/apps/
# Add "Facebook Login" + "Instagram Graph API" products and request:
#   instagram_basic, instagram_content_publish,
#   pages_show_list, pages_read_engagement
# Valid OAuth redirect URI must EXACTLY match META_CALLBACK_URL.
# NOTE: requires an Instagram Professional (Business/Creator) account
# linked to a Facebook Page. In Meta "development mode", only
# admins/developers/testers of the app can connect.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_CALLBACK_URL=http://localhost:5000/api/v1/auth/instagram/callback

# ── OpenAI (optional) ─────────────────────────────────────
# Used for Whisper API transcription + AI captions/titles/hashtags.
# Without it the system falls back to a local Whisper install.
OPENAI_API_KEY=

# ── Email (password reset) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TalishFlow <noreply@talishflow.com>"

# ── Storage ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5368709120

# ── Processing ────────────────────────────────────────────
# Leave blank to auto-resolve (bundled ffmpeg/ffprobe binaries).
FFMPEG_PATH=
FFPROBE_PATH=
WHISPER_MODEL=base
PYTHON_PATH=python3

# ── Cleanup ───────────────────────────────────────────────
ASSET_TTL_HOURS=24
